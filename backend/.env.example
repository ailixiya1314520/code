# 复制为 .env 并填写. 所有值都在 ThingsCloud 控制台获取:
#   TC_API / TC_PROJECT_KEY / 设备 token(AccessToken): 设备详情 > 连接
#   TC_VIEW_*: 项目 > 设置 > MQTT 应用端订阅
TC_API=https://gz-5-api.iot-api.com
TC_PROJECT_KEY=
TC_VIEW_URL=wss://gz-5-api.iot-api.com/mqtt/app
TC_VIEW_KEY=
TC_VIEW_SECRET=
AI_BASE=https://new.xkool.cfd/v1
AI_KEY=
AI_MODEL=deepseek-v4-flash
# 设备ID = 固件 TC_CLIENTID, token = 固件 TC_USERNAME; 多教室继续往里加
DEVICES={"2g2wslq6": {"name": "classroom-01", "token": ""}}
