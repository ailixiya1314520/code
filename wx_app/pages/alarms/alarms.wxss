/* 信号场 · 告警页 —— 对应网页版 strip + ribbons 行式布局 */

.page {
  padding-bottom: 40rpx;
}

/* ── 汇总数据条 ────────────────────────────── */
.strip {
  display: flex;
  border-bottom: 1rpx solid var(--line);
}

.strip-i {
  flex: 1;
  padding: 28rpx 16rpx 24rpx 32rpx;
  border-right: 1rpx solid var(--line);
  box-sizing: border-box;
  min-width: 0;
}

.strip-i:last-child {
  border-right: 0;
  padding-right: 32rpx;
}

.strip .l {
  display: block;
  font-size: 17rpx;
  letter-spacing: 3rpx;
  color: var(--faint);
  margin-bottom: 12rpx;
  white-space: nowrap;
}

.strip .n {
  display: block;
  font-size: 56rpx;
  font-weight: 300;
  line-height: 1;
}

/* ── 教室列表 ───────────────────────────────── */
.rooms {
  margin: 0 32rpx;
}

.room {
  border-bottom: 1rpx solid var(--line);
  padding: 26rpx 0;
}

.room.offline {
  opacity: 0.6;
}

.room-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.rib-l {
  flex: 1;
  min-width: 0;
}

.r-name {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
}

.r-id {
  display: block;
  font-size: 17rpx;
  color: var(--faint);
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 越限行（网页版 chip bad 风格） */
.over {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 16rpx;
}

.ov-mark {
  flex: none;
  width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  text-align: center;
  border: 1rpx solid rgba(255, 107, 107, 0.5);
  color: var(--bad);
  font-size: 18rpx;
  border-radius: 2rpx;
}

.ov-txt {
  font-size: 24rpx;
  color: var(--dim);
  line-height: 1.6;
  margin-top: 12rpx;
}

.over .ov-txt {
  color: var(--fg);
  margin-top: 0;
}

.room-foot {
  margin-top: 14rpx;
  font-size: 17rpx;
  color: var(--faint);
  letter-spacing: 1rpx;
}
